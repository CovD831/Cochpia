# Local QA/browser state and user-provided private uploads
.visual-qa-browser/
uploads/

# User-provided media: publish only after ownership/license is confirmed
client/public/306155_medium.mp4
scripts/eval-progress.log

# e2e run output: the log belongs to whoever ran it, not to the repo. The
# artifacts/*.json evidence files ARE committed (the cleanup docs cite them).
artifacts/e2e-server.log
artifacts/e2e-panels-server.log
.certs/

# Env backups carry secrets; they are rollback aids, not repo content
# (.env itself is ignored near the top of this file)
.env.bak*

# openssl -CAserial residue left by TLS cert generation (see .certs/)
.srl

# Python bytecode from running the e2e scripts (scripts/*.py)
__pycache__/
*.pyc

# Agent-run bookkeeping (team-runs manifests, deviation ledgers). Process
# metadata for a session, not project content: the handoff files and
# docs/rearchitecture/ already carry what the next session needs. Kept on
# disk, not in history.
.workbuddy/

# LoCoMo 评测数据集（2.8MB，不该进仓库）与跑批产物。
# 获取方式见 scripts/locomo-eval-evidence.mjs 头部（raw.githubusercontent 单文件）。
# 缺失时质量闸自动降级到内置小集，不会因此变红。
eval-data/
